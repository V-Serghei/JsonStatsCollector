<Window x:Class="JsonStatsCollector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JsonStatsCollector"
        xmlns:charting="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="JSON Stats Collector" Height="450" Width="800"
        MinWidth="600" MinHeight="400"
        Background="#F5F7FA">
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0056b3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="200" MaxWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel -->
        <Border Grid.Column="0" Background="White" Margin="10" CornerRadius="10" BorderBrush="#DEE2E6" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBox x:Name="TitleTextBox" Style="{StaticResource ModernTextBox}" 
                             Text="Analysis Title" FontWeight="Bold"/>
                    <TextBox x:Name="DescriptionTextBox" Style="{StaticResource ModernTextBox}" 
                             Text="Description" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilePathTextBox" Style="{StaticResource ModernTextBox}" 
                                 IsReadOnly="True" Text="No file selected"/>
                        <Button Grid.Column="1" Style="{StaticResource ModernButton}" 
                                Content="Browse" Click="BrowseButton_Click" Width="80"/>
                    </Grid>
                    <Button x:Name="AddNameButton" Style="{StaticResource ModernButton}" 
                            Content="Add Name" Click="AddNameButton_Click" Margin="5,10,5,5"/>
                    <ScrollViewer MaxHeight="150" Margin="0,5,0,0">
                        <StackPanel x:Name="NamesPanel"/>
                    </ScrollViewer>
                    <Button x:Name="AnalyzeButton" Style="{StaticResource ModernButton}" 
                            Content="Analyze" Click="AnalyzeButton_Click" VerticalAlignment="Bottom" Margin="5,20,5,5"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" Width="5" Background="#DEE2E6" 
                      VerticalAlignment="Stretch" HorizontalAlignment="Center"/>

        <!-- Right Panel -->
        <Border Grid.Column="2" Background="White" Margin="10" CornerRadius="10" BorderBrush="#DEE2E6" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock Text="Статистика по сообщениям" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,5"/>
                    <charting:PieChart Height="200" Margin="0,0,0,10"
                                       LegendLocation="Right" Series="{Binding StatisticsMessages}"/>
                    <TextBlock Text="Топ 10 слов" FontWeight="Bold" FontSize="16" Margin="0,10,0,5"/>
                    <ListView x:Name="Top10ListView" Height="150" Margin="0,0,0,10" d:DataContext="{d:DesignData }">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Слово" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Количество" Width="100" DisplayMemberBinding="{Binding Value}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                        <TextBlock Text="Статистика по словам" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,10,0,5"/>
                        <charting:PieChart  Height="200" Margin="0,0,5,0"
                                         LegendLocation="Right" Series="{Binding StatisticsWords}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                        <TextBlock Text="Статистика по буквам" 
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,10,0,5"/>
                        <charting:PieChart  Height="200" Margin="5,0,0,0"
                                         LegendLocation="Right" Series="{Binding StatisticsLetters}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>