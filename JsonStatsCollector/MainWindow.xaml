<Window x:Class="JsonStatsCollector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JsonStatsCollector"
        xmlns:charting="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="JSON Stats Collector" Height="550" Width="900"
        MinWidth="700" MinHeight="500"
        Background="#1E1E1E">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBackgroundColor" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SecondaryBackgroundColor" Color="#2D2D30"/>
        <SolidColorBrush x:Key="PrimaryForegroundColor" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3F3F46"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
        <SolidColorBrush x:Key="AccentHoverColor" Color="#0097FF"/>
        <SolidColorBrush x:Key="AccentPressedColor" Color="#005A9E"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}"/>
        </Style>
        
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPressedColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundColor}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryForegroundColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentHoverColor}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="5">
                            <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BorderColor}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="charting:DefaultTooltip">
            <Setter Property="Background" Value="{StaticResource SecondaryBackgroundColor}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
        </Style>
        <Style TargetType="charting:DefaultLegend">
            <Setter Property="Foreground" Value="{StaticResource PrimaryForegroundColor}"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="220" MaxWidth="450"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SecondaryBackgroundColor}" Margin="10" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15">
                    <TextBlock Text="Панель управления" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBox x:Name="TitleTextBox" Style="{StaticResource DarkTextBoxStyle}" Text="Analysis Title"/>
                    <TextBox x:Name="DescriptionTextBox" Style="{StaticResource DarkTextBoxStyle}" Text="Description" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                    
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilePathTextBox" Style="{StaticResource DarkTextBoxStyle}" IsReadOnly="True" Text="Файл не выбран"/>
                        <Button Grid.Column="1" Style="{StaticResource DarkButtonStyle}" Content="Обзор" Click="BrowseButton_Click"/>
                    </Grid>
                    
                    <Button x:Name="AddNameButton" Style="{StaticResource DarkButtonStyle}" Content="Добавить имя" Click="AddNameButton_Click" Margin="5,15,5,5"/>
                    <ScrollViewer MaxHeight="150" Margin="0,5,0,0">
                        <StackPanel x:Name="NamesPanel"/>
                    </ScrollViewer>
                    <Button x:Name="AnalyzeButton" Style="{StaticResource DarkButtonStyle}" Content="Анализировать" Click="AnalyzeButton_Click" Margin="5,20,5,5" FontWeight="Bold"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" Background="{StaticResource PrimaryBackgroundColor}" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>

        <Border Grid.Column="2" Background="{StaticResource SecondaryBackgroundColor}" Margin="10" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="15">
                    <TextBlock Text="Статистика по сообщениям" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,10"/>
                    <charting:PieChart Height="220" Series="{Binding StatisticsMessages}" LegendLocation="Right"/>
                    
                    <TextBlock Text="Топ 10 слов" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,20,0,5"/>
                    <ListView x:Name="Top10ListView" ItemsSource="{Binding Top10Stats}" Background="Transparent" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Слово" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Количество" Width="100" DisplayMemberBinding="{Binding Value}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                            <TextBlock Text="Статистика по словам" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                            <charting:PieChart Height="220" Series="{Binding StatisticsWords}" LegendLocation="Bottom"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                            <TextBlock Text="Статистика по буквам" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                            <charting:PieChart Height="220" Series="{Binding StatisticsLetters}" LegendLocation="Bottom"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>